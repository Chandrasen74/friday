<resources>
    <style name="Theme.FRIDAY" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/obsidian_void</item>
        <item name="android:statusBarColor">@color/obsidian_void</item>
        <item name="android:navigationBarColor">@color/obsidian_void</item>
    </style>

    <style name="Theme.FRIDAY.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/obsidian_void</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/friday_splash_icon</item>
        <item name="windowSplashScreenIconBackgroundColor">@color/obsidian_void</item>
        <item name="postSplashScreenTheme">@style/Theme.FRIDAY</item>
    </style>
</resources>
